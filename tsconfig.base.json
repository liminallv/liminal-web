{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    // Relative imports are written with an explicit `.ts` extension and rewritten to `.js`
    // on emit. That is what lets `node --test packages/*/test/**/*.test.ts` run the SOURCE
    // directly through Node's type stripping while the published `dist/` still contains
    // spec-correct ESM specifiers that resolve in Node, Vite and webpack alike.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    // Node's type stripping erases types without transforming syntax, so anything that
    // needs a runtime transform (enum, namespace, parameter properties) would run fine
    // through `tsc` and crash under `node file.ts`. Ban it at compile time instead.
    "erasableSyntaxOnly": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "skipLibCheck": true
  }
}
