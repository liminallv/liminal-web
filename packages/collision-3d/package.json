{
  "name": "@liminal-lv/collision-3d",
  "version": "0.9.1",
  "description": "Turn Liminal Editor level geometry into 3D collider shapes — boxes, spheres, capsules, convex point clouds, trimeshes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liminallv/liminal-web.git",
    "directory": "packages/collision-3d"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "keywords": [
    "liminal",
    "collision",
    "3d",
    "physics",
    "trimesh"
  ],
  "dependencies": {
    "@liminal-lv/core": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
